# Set environment variables in your shell; this file is not auto-loaded.
# No secrets are required for the default offline MVP.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
AI_PROVIDER=mock
GEMINI_API_KEY=
# Set an available Gemini model ID when explicitly enabling AI_PROVIDER=gemini.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=20
# Empty = in-memory storage. Optional local PostgreSQL requires requirements-postgres.txt.
DATABASE_URL=
# Empty/unset uses the packaged rules/rules_v1.json; omit rather than export blank.
# RULES_PATH=rules/rules_v1.json
# Optional parent directory; uploads live in a private temporary subdirectory.
# DOCUMENT_STORAGE_DIR=./tmp
MAX_UPLOAD_BYTES=10485760
# Used by python -m app.run / Docker, not the uvicorn CLI's default port.
PORT=8000
