digraph Data {
  graph [label="DISHARI  /  PROPOSED LOGICAL DATA MODEL", labelloc=t, labeljust=l, fontsize=24, fontname="DejaVu Sans", fontcolor="#1C2024", rankdir=LR, bgcolor="#F5F3EE", nodesep=0.6, ranksep=1.0, pad=0.4, splines=polyline];
  node [shape=record, style="rounded,filled", color="#D9D5CB", fillcolor="#FFFFFF", fontname="DejaVu Sans", fontsize=11, margin="0.2,0.18", penwidth=1.4];
  edge [color="#0E5A6B", arrowsize=0.7, penwidth=1.5, fontname="DejaVu Sans", fontsize=10];
  operator [label="{OPERATOR|operator_id (PK)\lorganization_id\lrole, status\l}", fillcolor="#E4EDEE", color="#0E5A6B"];
  cases [label="{CASE|case_id (PK)\loperator_id (FK)\lapplicant_type, crop, amount\llifecycle, retention_deadline\l}", fillcolor="#E4EDEE", color="#0E5A6B"];
  consent [label="{CONSENT_RECEIPT|receipt_id (PK)\lcase_id, actor_id\lpurpose, notice_version\lgranted_at, revoked_at\l}"];
  docs [label="{DOCUMENT|document_id (PK)\lcase_id (FK), type\lencrypted_object_key\luploaded_at, delete_at\l}"];
  facts [label="{EXTRACTED_FACT|fact_id (PK)\ldocument_id (FK)\lfield, masked_value\lconfidence, provenance\l}"];
  mismatch [label="{MISMATCH|mismatch_id (PK)\lcase_id (FK), fact_refs\linferred, reviewer_status\lfix_route\l}", fillcolor="#FDEBE8", color="#B3261E"];
  rulepack [label="{RULE_PACK|pack_id (PK)\lstate, version, approved_at\lsource URLs, effective_dates\l}", fillcolor="#FFF3D1", color="#A86B00"];
  evaluations [label="{CASE_RULE_EVALUATION|evaluation_id (PK)\lcase_id (FK), pack_id (FK)\lscheme_id, outcome\lprovisional, evidence\l}", fillcolor="#E7F3EA", color="#2F7D4A"];
  review [label="{OPERATOR_REVIEW|review_id (PK)\lcase_id, reviewer_id\lreviewed_at, acknowledgement\l}"];
  audit [label="{AUDIT_EVENT|event_id (PK)\lactor_id, case_id\laction, request_id, at\lNO RAW PII\l}"];
  operator -> cases [label="owns"];
  cases -> consent;
  cases -> docs;
  docs -> facts;
  cases -> mismatch;
  cases -> evaluations;
  rulepack -> evaluations [label="versioned source"];
  cases -> review;
  operator -> audit [style=dashed];
}
