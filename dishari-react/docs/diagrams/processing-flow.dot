digraph Process {
  graph [label="DISHARI  /  CASE LIFECYCLE & HUMAN APPROVAL", labelloc=t, labeljust=l, fontsize=24, fontname="DejaVu Sans", fontcolor="#1C2024", rankdir=TB, bgcolor="#F5F3EE", nodesep=0.5, ranksep=0.58, pad=0.3, splines=ortho];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, color="#D9D5CB", fillcolor="white", margin="0.2,0.16"];
  edge [color="#0E5A6B", arrowsize=0.75, penwidth=1.7, fontname="DejaVu Sans", fontsize=11];
  start [label="OPERATOR\nCapture citizen consent", fillcolor="#E4EDEE", color="#0E5A6B", penwidth=2];
  consent [label="Consent granted?", shape=diamond, fillcolor="#FFF3D1", color="#A86B00"];
  blocked [label="UI remains locked\nNo upload or processing", fillcolor="#FDEBE8", color="#B3261E"];
  form [label="Enter case details\nAttach 1–3 documents", fillcolor="#E4EDEE"];
  check [label="Explicit ‘Check case’ click\nPOST multipart manifest + files", fillcolor="#E4EDEE"];
  pipeline [label="Server: authenticate → validate → store temporarily\nOCR/Gemini extract → normalize → mismatch audit", fillcolor="#FFFFFF"];
  rules [label="Versioned deterministic eligibility rules\nMissing facts → cannot determine", fillcolor="#E7F3EA", color="#2F7D4A"];
  review [label="REVIEW SCREEN\nMismatch + scheme statuses + provenance", fillcolor="#FFFFFF"];
  approve [label="Operator approves findings?", shape=diamond, fillcolor="#FFF3D1", color="#A86B00"];
  revise [label="Back to edit / re-check\nNo submission", fillcolor="#FAF9F6"];
  summary [label="PRINTABLE BENGALI SUMMARY\nProvisional notices + sample warnings", fillcolor="#E7F3EA", color="#2F7D4A", penwidth=2];
  portal [label="OUTSIDE DISHARI\nOperator uses official portal\nFinal submission remains manual", fillcolor="#FAF9F6", color="#8C8A80"];
  retention [label="Retention controls\nDelete raw document objects on schedule", style="rounded,filled,dashed", fillcolor="#FAF9F6", color="#8C8A80"];
  start -> consent;
  consent -> blocked [label="no"];
  consent -> form [label="yes"];
  form -> check -> pipeline -> rules -> review -> approve;
  approve -> revise [label="no"];
  revise -> form [constraint=false];
  approve -> summary [label="yes"];
  summary -> portal [style=dashed, color="#8C8A80"];
  pipeline -> retention [style=dashed, color="#8C8A80", constraint=false];
}
